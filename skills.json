{
  "name": "malanskills-for-office-efficiency",
  "version": "0.1.0",
  "updated": "2026-10-03",
  "license": "MIT",
  "default_branch": "main",
  "language": ["zh-CN", "en"],
  "spec": "https://agentskills.io/specification",
  "summary_zh": "面向办公与组织效率提升的 Agent Skill 集合：招聘与人才评估、会议与协同、文档与数据处理、组织与团队效能。",
  "summary_en": "A bilingual collection of Agent Skills that improves office and organizational productivity: recruiting and talent evaluation, meetings and collaboration, document and data processing, and team effectiveness.",
  "homepage": "https://github.com/malan-skills/malanskills_for_office_efficiency",
  "registry_note": "Machine-readable skill registry. Mirrors the Skills Index table in README.md — keep both in sync when adding a skill. / 机器可读的 Skill 注册表，与 README.md 的 Skill 索引表保持同步，新增 Skill 时请同时更新两处。",
  "plugin": {
    "manifest": ".claude-plugin/plugin.json",
    "marketplace": ".claude-plugin/marketplace.json",
    "plugin_name": "malanskills-for-office-efficiency",
    "marketplace_name": "malanskills-office-efficiency",
    "skills_dir": "skills",
    "note": "Each skill lives under skills/<skill-name>/ and is self-contained: it references only files inside its own directory. / 每个 Skill 位于 skills/<skill-name>/ 且完全自包含，只引用自身目录内的文件。"
  },
  "install": {
    "plugin_marketplace_add": "claude plugin marketplace add malan-skills/malanskills_for_office_efficiency",
    "plugin_install": "claude plugin install malanskills-for-office-efficiency@malanskills-office-efficiency",
    "plugin_local_dev": "claude --plugin-dir <path-to-this-repo>",
    "agent_skills_cli": "npx skills add malan-skills/malanskills_for_office_efficiency --skill <skill-name>",
    "git_clone": "git clone https://github.com/malan-skills/malanskills_for_office_efficiency.git",
    "user_scope": "~/.claude/skills/<skill-name>/",
    "project_scope": "<project-root>/.claude/skills/<skill-name>/"
  },
  "categories": [
    { "id": "talent-acquisition", "name_zh": "招聘与人才评估", "name_en": "Talent Acquisition" },
    { "id": "meeting-collaboration", "name_zh": "会议与协同办公", "name_en": "Meetings & Collaboration" },
