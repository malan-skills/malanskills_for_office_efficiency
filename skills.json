  "skills": [
    {
      "name": "resume-screening",
      "path": "skills/resume-screening",
      "entry": "SKILL.md",
      "readme": "skills/resume-screening/README.md",
      "version": "1.0.0",
      "status": "stable",
      "updated": "2026-10-02",
      "category": "talent-acquisition",
      "stage_zh": "招聘与人才评估",
      "stage_en": "Talent acquisition",
      "title_zh": "简历批量筛选与岗位匹配度评分",
      "title_en": "Batch Resume Screening & Job-Fit Scoring",
      "description_zh": "解析 PDF / Word / TXT / MD 简历，依据岗位评分模型从核心底层要求、岗位职责、岗位必备条件、岗位加分项、实践经验描述标准 5 个维度打分（各 20 分，总分 100 分），硬性淘汰规则优先执行，输出候选人评分汇总表格、是否通过初筛（>=80 分）与面试侧重点建议。",
      "description_en": "Parse PDF/DOCX/TXT/MD resumes and score each candidate against a role scorecard across five dimensions (core fundamentals, responsibilities, must-have conditions, nice-to-haves, evidence-of-practice), 20 points each, with hard knock-out rules applied first. Outputs a ranked shortlist table, a pass/fail flag at 80/100, and interview focus areas.",
      "keywords": [
        "简历筛选",
        "简历评估",
        "简历打分",
        "简历匹配度",
        "简历与岗位匹配",
        "批量简历评估",
        "招聘初筛",
        "候选人打分",
        "人才筛选",
        "简历排序",
        "简历解析",
        "求职筛选",
        "面试建议",
        "resume screening",
        "resume scoring",
        "resume evaluation",
        "candidate evaluation",
        "candidate shortlist",
        "job fit score",
        "resume ranking",
        "recruiting",
        "talent screening",
        "hiring",
        "hr automation",
        "resume parser",
        "interview focus"
      ],
      "inputs": ["简历附件（PDF / DOCX / TXT / MD）", "目标岗位名称"],
      "outputs": ["候选人评分汇总表（Markdown）", "初筛通过统计", "面试侧重点建议"],
      "data_sources": ["用户上传的简历附件", "references/jobs 下的岗位评分模型"],
      "scripts": [
        "skills/resume-screening/scripts/extract_resume_text.py",
        "skills/resume-screening/scripts/calculate_match_score.py",
        "skills/resume-screening/scripts/summarize_batch.py"
      ],
      "tests": [],
      "examples": ["skills/resume-screening/README.md"],
      "runtime": {
        "language": "python",
        "version": ">=3.9",
        "third_party_deps": ["pypdf", "pdfplumber", "pdfminer.six", "pypdfium2", "python-docx"],
        "network_required": false,
        "note": "TXT/MD parsing is dependency-free; PDF and DOCX parsing degrade gracefully across multiple engines. No network calls. / 纯文本解析零依赖；PDF 与 Word 走多引擎容错；不发起网络请求。"
      }
    }
  ],
